@page "/collection"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MtgBulk.Data
@using MtgBulk.Models
@using MtgBulk.Components.Cards
@inject AppDbContext Db
@implements IDisposable

<PageTitle>Samling</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Samling (@totalCount)</h1>
    <button class="btn btn-danger" disabled="@(totalCount == 0)" @onclick="ClearAllAsync">Rensa samling</button>
</div>

@if (!string.IsNullOrEmpty(status))
{
    <div class="alert alert-success">@status</div>
}

<div class="input-group mb-3">
    <input class="form-control" placeholder="Sök namn..." value="@search" @oninput="OnSearchInput" />
    @if (!string.IsNullOrEmpty(search))
    {
        <button class="btn btn-outline-secondary" @onclick="ClearSearchAsync">Rensa</button>
    }
</div>

<CardTable Cards="cards" SortColumn="@sortColumn" SortAscending="@sortAscending" OnSort="OnSortChanged" OnDelete="DeleteCardAsync" />

<div class="d-flex gap-2 align-items-center mt-2">
    <button class="btn btn-secondary" disabled="@(currentPage <= 1)" @onclick="PrevPage">Förra</button>
    <span>Sida @currentPage av @totalPages</span>
    <button class="btn btn-secondary" disabled="@(currentPage >= totalPages)" @onclick="NextPage">Nästa</button>
</div>

@code {
    private List<MtgCard> cards = [];
    private string search = string.Empty;
    private string sortColumn = "Name";
    private bool sortAscending = true;
    private int currentPage = 1;
    private const int pageSize = 20;
    private int totalCount;
    private int totalPages = 1;
    private string status = string.Empty;
    private CancellationTokenSource? searchCts;

    protected override async Task OnInitializedAsync() => await LoadPageAsync();

    public void Dispose() => searchCts?.Cancel();

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;

        searchCts?.Cancel();
        searchCts?.Dispose();
        searchCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(300, searchCts.Token);
            await LoadPageAsync();
        }
        catch (TaskCanceledException)
        {
            // Nytt tecken hann skrivas in - ignorera denna sökning.
        }
    }

    private async Task ClearSearchAsync()
    {
        searchCts?.Cancel();
        search = string.Empty;
        currentPage = 1;
        await LoadPageAsync();
    }

    private async Task OnSortChanged(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 1;
        await LoadPageAsync();
    }

    private async Task PrevPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadPageAsync();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadPageAsync();
        }
    }

    private async Task DeleteCardAsync(int id)
    {
        var card = await Db.Cards.FindAsync(id);
        if (card is null)
            return;

        Db.Cards.Remove(card);
        await Db.SaveChangesAsync();
        status = $"Tog bort {card.Name}.";
        await LoadPageAsync();
    }

    private async Task ClearAllAsync()
    {
        await Db.Cards.ExecuteDeleteAsync();
        currentPage = 1;
        status = "Samlingen rensad.";
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        var query = Db.Cards.AsQueryable();

        var trimmed = search.Trim();
        if (!string.IsNullOrWhiteSpace(trimmed))
        {
            // Contains() blir case-sensitive i SQLite (instr), LIKE är
            // case-insensitive. Escapa LIKE-wildcards så att t.ex. "%" söks bokstavligt.
            var pattern = $"%{EscapeLikePattern(trimmed)}%";
            query = query.Where(c => EF.Functions.Like(c.Name, pattern, "\\"));
        }

        totalCount = await query.CountAsync();
        totalPages = Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
        currentPage = Math.Clamp(currentPage, 1, totalPages);

        query = (sortColumn, sortAscending) switch
        {
            ("Set", true) => query.OrderBy(c => c.SetCode),
            ("Set", false) => query.OrderByDescending(c => c.SetCode),
            ("Quantity", true) => query.OrderBy(c => c.Quantity),
            ("Quantity", false) => query.OrderByDescending(c => c.Quantity),
            ("PriceEur", true) => query.OrderBy(c => c.PriceEur),
            ("PriceEur", false) => query.OrderByDescending(c => c.PriceEur),
            ("Source", true) => query.OrderBy(c => c.Source),
            ("Source", false) => query.OrderByDescending(c => c.Source),
            ("Colors", true) => query.OrderBy(c => c.Colors),
            ("Colors", false) => query.OrderByDescending(c => c.Colors),
            (_, false) => query.OrderByDescending(c => c.Name),
            _ => query.OrderBy(c => c.Name),
        };

        cards = await query.Skip((currentPage - 1) * pageSize).Take(pageSize).ToListAsync();
    }

    private static string EscapeLikePattern(string value) =>
        value.Replace("\\", "\\\\").Replace("%", "\\%").Replace("_", "\\_");
}
