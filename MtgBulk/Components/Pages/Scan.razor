@page "/scan"
@rendermode InteractiveServer
@using MtgBulk.Services
@inject CardRecognitionService Recognition

<PageTitle>Skanna kort</PageTitle>

<h1>Skanna kort</h1>
<p class="text-muted">Välj ett kortfoto > OCR läser namnet > Scryfall matchar > sparas i databasen.</p>

<InputFile OnChange="OnFilePicked" accept="image/*" />
<br /><br />

<button class="btn btn-primary" disabled="@(pickedFile is null || busy)" @onclick="ScanAsync">
    @(busy 
    ? "Skannar..." 
    : "Skanna och spara")
</button>

@if (!string.IsNullOrEmpty(status))
{
    <div class="alert alert-info mt-3">@status</div>
}

@if (result?.Card is not null)
{
    <div class="card mt-3" style="max-width: 400px">
        @if (!string.IsNullOrEmpty(result.Card.ImageNormal))
        {
            <img src="@result.Card.ImageNormal" class="card-img-top" alt="@result.Card.Name" />
        }
        <div class="card-body">
            <h5>@result.Card.Name (@result.Card.SetCode.ToUpper())</h5>
            <p>Antal: @result.Card.Quantity • EUR: @(result.Card.PriceEur?.ToString("0.00") ?? "-")</p>
            <details>
                <summary>OCR-råtext</summary>
                <pre>@result.RawText</pre>
            </details>
        </div>
    </div>
}

@code {
    private IBrowserFile? pickedFile;
    private bool busy;
    private string status = string.Empty;
    private RecognizeResult? result;

    private void OnFilePicked(InputFileChangeEventArgs e)
    {
        pickedFile = e.File;
        status = $"Vald: {pickedFile.Name}";
        result = null;
    }

    private async Task ScanAsync()
    {
        if (pickedFile is null)
            return;

        busy = true;
        status = "Laddar upp och analyserar...";
        try
        {
            await using var stream = pickedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var copy = new MemoryStream();
            await stream.CopyToAsync(copy);
            copy.Position = 0;

            result = await Recognition.RecognizeAndSaveAsync(copy);
            status = result.Success
                ? $"Hittat: {result.CardName}"
                : $"Misslyckades: {result.Error}";
        }
        catch (Exception ex)
        {
            status = $"Fel: {ex.Message}";
        }
        busy = false;
    }
}
