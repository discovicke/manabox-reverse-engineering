@using MtgBulk.Models

@if (Cards.Count == 0)
{
    <p>Inga kort ännu. Importera CSV eller skanna ett kort.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th></th>
                <th><button class="btn btn-link p-0" @onclick='() => OnSort.InvokeAsync("Name")'>Namn @Arrow("Name")</button></th>
                <th><button class="btn btn-link p-0" @onclick='() => OnSort.InvokeAsync("Set")'>Set @Arrow("Set")</button></th>
                <th><button class="btn btn-link p-0" @onclick='() => OnSort.InvokeAsync("Colors")'>Färg @Arrow("Colors")</button></th>
                <th><button class="btn btn-link p-0" @onclick='() => OnSort.InvokeAsync("Quantity")'>Antal @Arrow("Quantity")</button></th>
                <th><button class="btn btn-link p-0" @onclick='() => OnSort.InvokeAsync("PriceEur")'>EUR @Arrow("PriceEur")</button></th>
                <th><button class="btn btn-link p-0" @onclick='() => OnSort.InvokeAsync("Source")'>Källa @Arrow("Source")</button></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var card in Cards)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(card.ImageSmall))
                        {
                            <img src="@card.ImageSmall" width="40" alt="@card.Name" />
                        }
                    </td>
                    <td>@card.Name</td>
                    <td>@card.SetCode.ToUpper() #@card.CollectorNumber</td>
                    <td>@ColorBadges(card.Colors)</td>
                    <td>@card.Quantity</td>
                    <td>@(card.PriceEur?.ToString("0.00") ?? "-")</td>
                    <td>@card.Source</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter]
    public List<MtgCard> Cards { get; set; } = [];

    [Parameter]
    public string SortColumn { get; set; } = "Name";

    [Parameter]
    public bool SortAscending { get; set; } = true;

    [Parameter]
    public EventCallback<string> OnSort { get; set; }

    private string Arrow(string column) =>
        SortColumn != column 
            ? "" 
            : SortAscending 
                ? "^" 
                : "v";

    private string ColorBadges(string colors) =>
        string.IsNullOrEmpty(colors) 
            ? "Färglöst" 
            : colors.Length > 1 
                ? $"Multi ({colors})" 
                : colors;
}
